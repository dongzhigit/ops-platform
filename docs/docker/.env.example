# Copy this file to .env and replace every required value before starting.
# Generate a Django key with: openssl rand -base64 48
SPUG_SECRET_KEY=
# Generate separately with: openssl rand -base64 32
SPUG_CREDENTIAL_MASTER_KEY=
# Optional staged-rotation keyring. Keep the current key under "primary",
# add the new key under a new ID, then follow docs/M1_ASSET_ACCESS.md.
SPUG_CREDENTIAL_KEYRING=
SPUG_CREDENTIAL_PRIMARY_KEY_ID=primary
# Generate a third independent value with: openssl rand -base64 48
SPUG_AUDIT_SIGNING_KEY=
# Generate independently with: openssl rand -hex 16
# This exact 32-character hex value is shared only with Guacamole JSON auth.
SPUG_GUACAMOLE_JSON_SECRET_KEY=
SPUG_REMOTE_GATEWAY_ENABLED=true
SPUG_GUACAMOLE_PUBLIC_URL=/guacamole
SPUG_REMOTE_TICKET_TTL=60
SPUG_GUACAMOLE_AUTH_TTL=60

# Prometheus/Alertmanager tokens are stored as files, not in this env file.
SPUG_OBSERVABILITY_ENABLED=true
SPUG_OBSERVABILITY_SECRETS_ROOT=./secrets
# Must not overlap any managed host, model service, VPN, or LAN subnet.
SPUG_OBSERVABILITY_SUBNET=172.23.0.0/16
SPUG_PROMETHEUS_RETENTION=30d
SPUG_OBSERVABILITY_REQUEST_TIMEOUT=10
SPUG_ALERT_RETENTION_DAYS=90

# Optional bootstrap/fallback for read-only AI investigations. Administrators
# can instead store an encrypted runtime configuration from the AI operations page.
# When enabled here, create ./secrets/aiops_api_key and set the container path below.
SPUG_AIOPS_ENABLED=false
SPUG_AIOPS_API_FORMAT=openai
SPUG_AIOPS_BASE_URL=https://model.example.com/v1
SPUG_AIOPS_MODEL=
SPUG_AIOPS_API_KEY_FILE=
SPUG_AIOPS_JSON_MODE=true
SPUG_AIOPS_REQUEST_TIMEOUT=30
SPUG_AIOPS_MAX_HOSTS=20
SPUG_AIOPS_KNOWLEDGE_LIMIT=8
SPUG_AIOPS_MAX_OUTPUT_TOKENS=2000
SPUG_AIOPS_MAX_RESPONSE_BYTES=1048576
SPUG_AIOPS_RATE_LIMIT_PER_MINUTE=5
SPUG_SECRETS_ROOT=./secrets

# Public hostname(s), comma separated. Do not use * in production.
SPUG_ALLOWED_HOSTS=ops.example.com
# Django 2.2 uses host names here; the planned framework upgrade will migrate
# this value to the scheme-qualified format required by modern Django.
SPUG_CSRF_TRUSTED_ORIGINS=ops.example.com

# Bind to loopback when a reverse proxy runs on the same host.
SPUG_BIND_HOST=127.0.0.1
SPUG_PORT=80
SPUG_SECURE_COOKIES=true
SPUG_SSL_REDIRECT=false

# Store persistent data outside the source tree in production.
SPUG_DATA_ROOT=./data
OPS_PLATFORM_IMAGE=ops-platform:local
# Transitional platform pin for the CentOS 7/Python 3.6 image.
SPUG_PLATFORM=linux/amd64

MYSQL_DATABASE=spug
MYSQL_USER=spug
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
